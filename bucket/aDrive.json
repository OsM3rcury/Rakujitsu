{
    "version": "6.9.3.1875",
    "description": "阿里云盘桌面客户端 - 备份无忧 整理有序",
    "homepage": "https://www.alipan.com/",
    "license": {
        "identifier": "EULA"
    },
    "url": "https://sw.pcmgr.qq.com/ca24e11bd34b96b0dc96fbf5a3c98295/6a6b63e8/spcmgr/download/aDrive-6.9.3.exe#/dl.7z",
    "hash": "3ccbdfa920528bd0295c1197a84bcd552cc1cfe2bf2ad722ace7d5dd93bdb281",
    "pre_install": [
        "if (Test-Path \"$dir\\`$PLUGINSDIR\\app-64.7z\") {",
        "    Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
        "}",
        "Remove-Item \"$dir\\`$*\", \"$dir\\Uninst*\" -Force -Recurse"
    ],
    "persist": [],
    "post_install": [
        "$appdata = \"$env:APPDATA\\aDrive\"",
        "if (!(Test-Path $persist_dir)) { New-Item $persist_dir -ItemType Directory -Force | Out-Null }",
        "if (Test-Path $appdata) {",
        "    if (-not (Get-Item $appdata).Attributes.HasFlag([System.IO.FileAttributes]::ReparsePoint)) {",
        "        Move-Item \"$appdata\\*\" $persist_dir -Force -ErrorAction SilentlyContinue",
        "        Remove-Item $appdata -Force -Recurse",
        "    } else { Remove-Item $appdata -Force }",
        "}",
        "New-Item -ItemType Junction -Path $appdata -Target $persist_dir | Out-Null"
    ],
    "uninstaller": {
        "script": [
            "$appdata = \"$env:APPDATA\\aDrive\"",
            "if (Test-Path $appdata) {",
            "    $item = Get-Item $appdata",
            "    if ($item.Attributes.HasFlag([System.IO.FileAttributes]::ReparsePoint)) { Remove-Item $appdata -Force }",
            "}"
        ]
    },
    "bin": "aDrive.exe",
    "shortcuts": [
        [
            "aDrive.exe",
            "阿里云盘"
        ]
    ],
    "checkver": {
        "script": [
            "$resp = Invoke-WebRequest -UseBasicParsing -Uri 'https://luban.m.qq.com/api/public/software-manager/softwareProxy' -Body 'cmdid=3318&jprxReq%5Breq%5D%5Bsoft_id_list%5D%5B%5D=28156' -Method 'POST'",
            "Write-Output $resp.Content"
        ],
        "regex": "\"ver_name\":\"([\\d.]+)\".+\"download_https_url\":\"https://(?<url>.+exe)\""
    },
    "autoupdate": {
        "url": "https://$matchUrl#/dl.7z"
    }
}