    },
    "url": "https://sw.pcmgr.qq.com/ca24e11bd34b96b0dc96fbf5a3c98295/6a6b63e8/spcmgr/download/aDrive-6.9.3.exe#/dl.7z",
    "hash": "3ccbdfa920528bd0295c1197a84bcd552cc1cfe2bf2ad722ace7d5dd93bdb281",
    "innosetup": true,
    "installer": {
        "script": [
            "if (!(Test-Path $persist_dir)) { New-Item $persist_dir -Type Directory -Force | Out-Null }",
            "$runtimeAppdata = \"$env:APPDATA\\aDrive\"",
            "$runtimePersist = \"$persist_dir\\appdata\"",
            "if (Test-Path $runtimePersist) {",
            "    Remove-Item $runtimeAppdata -Force -Recurse -ErrorAction SilentlyContinue",
            "    New-Item -Type Junction -Path $runtimeAppdata -Target $runtimePersist | Out-Null",
            "} else {",
            "    if (Test-Path $runtimeAppdata) {",
            "        Move-Item $runtimeAppdata $runtimePersist -Force",
            "        New-Item -Type Junction -Path $runtimeAppdata -Target $runtimePersist | Out-Null",
            "    }",
            "}"
        ]
    },
    "uninstaller": {
        "script": [
            "$runtimeAppdata = \"$env:APPDATA\\aDrive\"",
            "$runtimePersist = \"$persist_dir\\appdata\"",
            "if (!(Test-Path $runtimePersist)) {",
            "    Move-Item $runtimeAppdata $runtimePersist -Force",
            "} else {",
            "    Remove-Item $runtimeAppdata -Force -Recurse -ErrorAction SilentlyContinue",
            "}"
        ]
    },
    "bin": "aDrive.exe",
    "shortcuts": [
        [
            "aDrive.exe",
            "阿里云盘"
        ]
    ],
    "checkver": {
        "script": [
            "$resp = Invoke-WebRequest -UseBasicParsing -Uri 'https://luban.m.qq.com/api/public/software-manager/softwareProxy' -Body 'cmdid=3318&jprxReq%5Breq%5D%5Bsoft_id_list%5D%5B%5D=28156' -Method 'POST'",
            "Write-Output $resp.Content"
        ],
        "regex": "\"ver_name\":\"([\\d.]+)\".+\"download_https_url\":\"https://(?<url>.+exe)\""
    },
    "autoupdate": {
        "url": "https://$matchUrl#/dl.7z"
    }
}
