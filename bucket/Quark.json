{
    "version": "7.1.5.968",
    "description": "夸克浏览器 - AI旗舰应用，极速、智能、高效的搜索浏览体验",
    "homepage": "https://www.quark.cn/",
    "license": {
        "identifier": "Proprietary",
        "url": "https://terms.alicdn.com/legal-agreement/terms/c_end_product_protocol/20230727183841535/20230727183841535.html"
    },
    "architecture": {
        "64bit": {
            "url": "https://umcdn.quark.cn/download/37212/quarkpc/pcquark@homepage_oficial/QuarkPC_V7.1.5.968_pc_pf30002_(zh-cn)_release_(Build3154107-1000-x64).exe",
            "hash": "6d1ed4309b43aabbd85021058028663edf1bc63a7cfbea5037abc2e985ba4974"
        }
    },
    "innosetup": true,
    "pre_install": [
        "Move-Item -Path \"$dir\\{code_GetAppExeDestName}\" -Destination \"$dir\\quark.exe\" -Force",
        "Move-Item -Path \"$dir\\{code_GetAppProxyExeDestName}\" -Destination \"$dir\\quark_proxy.exe\" -Force"
    ],
    "bin": "quark.exe",
    "shortcuts": [
        [
            "quark.exe",
            "夸克"
        ]
    ],
    "post_install": [
        "$target = \"$env:LOCALAPPDATA\\Quark\"",
        "if (!(Test-Path $persist_dir)) { New-Item $persist_dir -ItemType Directory -Force | Out-Null }",
        "if (Test-Path $target) {",
        "    if (-not (Get-Item $target).Attributes.HasFlag([System.IO.FileAttributes]::ReparsePoint)) {",
        "        Move-Item \"$target\\*\" $persist_dir -Force -ErrorAction SilentlyContinue",
        "        Remove-Item $target -Force -Recurse",
        "    } else { Remove-Item $target -Force }",
        "}",
        "New-Item -ItemType Junction -Path $target -Target $persist_dir | Out-Null"
    ],
    "uninstaller": {
        "script": [
            "$target = \"$env:LOCALAPPDATA\\Quark\"",
            "if (Test-Path $target) {",
            "    $item = Get-Item $target",
            "    if ($item.Attributes.HasFlag([System.IO.FileAttributes]::ReparsePoint)) { Remove-Item $target -Force }",
            "}"
        ]
    },
    "checkver": {
        "script": [
            "$entry = 'https://download.quark.cn/download/quarkpc?platform=pc&ch=pcquark@homepage_oficial'",
            "$req = [System.Net.WebRequest]::Create($entry)",
            "$req.AllowAutoRedirect = $false",
            "$resp = $req.GetResponse()",
            "$resolved = $resp.Headers['Location']",
            "$resp.Close()",
            "return $resolved"
        ],
        "regex": "(?<url>https?://.*?/QuarkPC_V([\\d.]+)_pc_pf30002_\\(zh-cn\\)_.*?\\.exe)"
    },
    "autoupdate": {
        "url": "$matchUrl",
        "hash": {
            "mode": "download"
        }
    }
}
