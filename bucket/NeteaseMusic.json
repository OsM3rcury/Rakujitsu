    "pre_install": [
        "if (Test-Path \"$dir\\redist_packages\") {",
        "    Get-ChildItem \"$dir\\redist_packages\\*\" | Move-Item -Destination \"$dir\" -Force",
        "}",
        "Remove-Item \"$dir\\`$PLUGINSDIR\", \"$dir\\redist_packages\" -Force -Recurse -ErrorAction SilentlyContinue"
    ],
    "bin": "cloudmusic.exe",
    "shortcuts": [
        [
            "cloudmusic.exe",
            "网易云音乐"
        ]
    ],
    "post_install": [
        "$appdata_parent = \"$env:LOCALAPPDATA\\Netease\"",
        "$appdata = \"$appdata_parent\\CloudMusic\"",
        "if (!(Test-Path $persist_dir)) { New-Item $persist_dir -ItemType Directory -Force | Out-Null }",
        "if (!(Test-Path $appdata_parent)) { New-Item $appdata_parent -ItemType Directory -Force | Out-Null }",
        "if (Test-Path $appdata) {",
        "    if (-not (Get-Item $appdata).Attributes.HasFlag([System.IO.FileAttributes]::ReparsePoint)) {",
        "        Move-Item \"$appdata\\*\" $persist_dir -Force -ErrorAction SilentlyContinue",
        "        Remove-Item $appdata -Force -Recurse",
        "    } else { Remove-Item $appdata -Force }",
        "}",
        "New-Item -ItemType Junction -Path $appdata -Target $persist_dir | Out-Null"
    ],
    "uninstaller": {
        "script": [
            "$appdata = \"$env:LOCALAPPDATA\\Netease\\CloudMusic\"",
            "if (Test-Path $appdata) {",
            "    $item = Get-Item $appdata",
            "    if ($item.Attributes.HasFlag([System.IO.FileAttributes]::ReparsePoint)) { Remove-Item $appdata -Force }",
            "}"
        ]
    },
    "checkver": {
        "url": "https://music.163.com/api/appcustomconfig/get",
