{
    "homepage": "https://music.163.com/",
    "description": "The official NetEase Cloud Music client.",
    "version": "3.1.36.205322",
    "license": {
        "identifier": "EULA",
        "url": "https://music.163.com/html/web2/service.html"
    },
    "url": "https://sw.pcmgr.qq.com/ad9722b655daea5118603895f8a6ca9a/6a6b67d0/spcmgr/download/NeteaseCloudMusic_Music_official_3.1.36.205322_64.exe#/dl.7z",
    "hash": "1985907e6649a5e44f5cdd45e8ce9f3154347c9caa70d57b81a69972087e134a",
    "installer": {
        "script": [
            "Get-ChildItem \"$dir\\redist_packages\" | Move-Item -Destination \"$dir\" -Force",
            "$runtimeAppdata = \"$env:LOCALAPPDATA\\Netease\\CloudMusic\"",
            "$runtimePersist = \"$persist_dir\\appdata\"",
            "if (Test-Path $runtimePersist) {",
            "    Remove-Item $runtimeAppdata -Force -Recurse -ErrorAction SilentlyContinue",
            "    New-Item -Type Junction -Path $runtimeAppdata -Target $runtimePersist | Out-Null",
            "} else {",
            "    if (Test-Path $runtimeAppdata) {",
            "        Move-Item $runtimeAppdata $runtimePersist -Force",
            "        New-Item -Type Junction -Path $runtimeAppdata -Target $runtimePersist | Out-Null",
            "    }",
            "}"
        ]
    },
    "post_install": "Remove-Item \"$dir\\`$PLUGINSDIR\",\"$dir\\redist_packages\" -Force -Recurse",
    "uninstaller": {
        "script": [
            "$runtimeAppdata = \"$env:LOCALAPPDATA\\Netease\\CloudMusic\"",
            "$runtimePersist = \"$persist_dir\\NeteaseMusic\\appdata\"",
            "if (!(Test-Path $runtimePersist)) {",
            "    Move-Item $runtimeAppdata $runtimePersist -Force -ErrorAction SilentlyContinue",
            "} else {",
            "    Remove-Item $runtimeAppdata -Force -Recurse -ErrorAction SilentlyContinue",
            "}"
        ]
    },
    "bin": "cloudmusic.exe",
    "shortcuts": [
        [
            "cloudmusic.exe",
            "网易云音乐"
        ]
    ],
    "checkver": {
        "script": [
            "$resp = Invoke-WebRequest -UseBasicParsing -Uri 'https://luban.m.qq.com/api/public/software-manager/softwareProxy' -Body 'cmdid=3318&jprxReq%5Breq%5D%5Bsoft_id_list%5D%5B%5D=11167' -Method 'POST'",
            "Write-Output $resp.Content"
        ],
        "regex": "\"ver_name\":\"([\\d.]+)\".+\"download_https_url\":\"https://(?<url>.+exe)\""
    },
    "autoupdate": {
        "url": "https://$matchUrl#/dl.7z"
    }
}
