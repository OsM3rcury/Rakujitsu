{
    "version": "2.3.62834",
    "description": "TRAE Work, an AI-native workspace with Work and Code dual modes, available as web, desktop, and mobile",
    "homepage": "https://www.trae.cn/work",
    "license": "Proprietary",
    "url": "https://lf-cdn.trae.com.cn/obj/trae-com-cn/pkg/app/releases/stable/2.3.62834/win32/TRAE_Work_CN-Setup-x64.exe",
    "hash": "f15b4430d74195156f37de03164c6f27e14306024f1e0962aa9dab2084bce8e1",
    "innosetup": true,
    "bin": "Trae CN.exe",
    "shortcuts": [
        [
            "Trae CN.exe",
            "Trae Work"
        ]
    ],
    "post_install": [
        "$appdata = \"$env:APPDATA\\Trae CN\"",
        "if (!(Test-Path $persist_dir)) { New-Item $persist_dir -ItemType Directory -Force | Out-Null }",
        "if (Test-Path $appdata) {",
        "    if (-not (Get-Item $appdata).Attributes.HasFlag([System.IO.FileAttributes]::ReparsePoint)) {",
        "        Move-Item \"$appdata\\*\" $persist_dir -Force -ErrorAction SilentlyContinue",
        "        Remove-Item $appdata -Force -Recurse",
        "    } else { Remove-Item $appdata -Force }",
        "}",
        "New-Item -ItemType Junction -Path $appdata -Target $persist_dir | Out-Null"
    ],
    "uninstaller": {
        "script": [
            "$appdata = \"$env:APPDATA\\Trae CN\"",
            "if (Test-Path $appdata) {",
            "    $item = Get-Item $appdata",
            "    if ($item.Attributes.HasFlag([System.IO.FileAttributes]::ReparsePoint)) { Remove-Item $appdata -Force }",
            "}"
        ]
    },
    "checkver": {
        "url": "https://api.trae.cn/icube/api/v1/native/version/trae/cn/latest",
        "jsonpath": "$.data.solo.win32.version"
    },
    "autoupdate": {
        "url": "https://lf-cdn.trae.com.cn/obj/trae-com-cn/pkg/app/releases/stable/$version/win32/TRAE_Work_CN-Setup-x64.exe"
    }
}
