{
    "version": "8.7.9.102",
    "description": "百度网盘 PC 版",
    "homepage": "https://pan.baidu.com/",
    "license": {
        "identifier": "Proprietary",
        "url": "https://pan.baidu.com/disk/duty/"
    },
    "architecture": {
        "64bit": {
            "url": "https://issuecdn.baidupcs.com/issue/netdisk/yunguanjia/BaiduNetdisk_8.7.9.102.exe#/dl.7z",
            "hash": "a2f9c3ae9c51678963c9c63b61b588976f9b15761b70192bff259db931d8bb4d"
        }
    },
    "bin": "BaiduNetdisk.exe",
    "shortcuts": [
        [
            "BaiduNetdisk.exe",
            "百度网盘"
        ]
    ],
    "persist": "users",
    "post_install": [
        "Remove-Item \"$dir\\`$PLUGINSDIR\", \"$dir\\`$TEMP\" -Force -Recurse -ErrorAction SilentlyContinue",
        "$paths = @{",
        "    'guanjia' = \"$env:APPDATA\\BaiduYunGuanjia\"",
        "    'kernel'  = \"$env:APPDATA\\BaiduYunKernel\"",
        "}",
        "$paths.GetEnumerator() | ForEach-Object {",
        "    $name = $_.Key; $runtime = $_.Value; $persist = \"$persist_dir\\$name\"",
        "    if (!(Test-Path $persist)) { New-Item $persist -Type Directory -Force | Out-Null }",
        "    if (Test-Path $runtime) {",
        "        if (-not (Get-Item $runtime).Attributes.HasFlag([System.IO.FileAttributes]::ReparsePoint)) {",
        "            Move-Item \"$runtime\\*\" $persist -Force -ErrorAction SilentlyContinue",
        "            Remove-Item $runtime -Force -Recurse",
        "        } else { Remove-Item $runtime -Force }",
        "    }",
        "    New-Item -Type Junction -Path $runtime -Target $persist | Out-Null",
        "}"
    ],
    "uninstaller": {
        "script": [
            "if (Get-Process -Name YunDetectService -ErrorAction SilentlyContinue) { Stop-Process -Name YunDetectService -Force }",
            "$paths = @(\"$env:APPDATA\\BaiduYunGuanjia\", \"$env:APPDATA\\BaiduYunKernel\")",
            "$paths | ForEach-Object {",
            "    if (Test-Path $_) {",
            "        $item = Get-Item $_",
            "        if ($item.Attributes.HasFlag([System.IO.FileAttributes]::ReparsePoint)) { Remove-Item $_ -Force }",
            "    }",
            "}"
        ]
    },
    "checkver": {
        "url": "https://pan.baidu.com/disk/cmsdata?do=client",
        "jsonpath": "$.guanjia.url",
        "regex": "BaiduNetdisk_([\\d.]+).exe"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://issuecdn.baidupcs.com/issue/netdisk/yunguanjia/BaiduNetdisk_$version.exe#/dl.7z"
            }
        }
    }
}
