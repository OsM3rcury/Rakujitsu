{
    "version": "0.109.0.0",
    "description": "KOOK, formerly KaiHeiLa, is a voice communication tool that is known as the Chinese Discord",
    "homepage": "https://www.kookapp.cn/",
    "license": "Proprietary",
    "url": "https://dl.kookapp.cn/assets/release/html_pc/kook_3037/Kook_PC_Setup_v0.109.0.0_b2ZmaWNpYWwuc2l0ZS4uLi5wYw==.exe?auth_key=1785427639-4715819a865a19294f6d0887ad8c59c0-13lm0mtz0-4bb20964a539597b1684912656ad5048#/dl.7z",
    "hash": "1cc9d34efb23327752f7b55c3b47c89473ff80bfcaba265661dfa841517e0ebb",
    "pre_install": [
        "if (Test-Path \"$dir\\`$1\\SquirrelTemp\\app.7z\") {",
        "    Expand-7zipArchive \"$dir\\`$1\\SquirrelTemp\\app.7z\" \"$dir\" -Removal",
        "}",
        "Get-ChildItem \"$dir\\KOOK-*-full.nupkg\" | ForEach-Object {",
        "    Expand-7zipArchive $_.FullName -ExtractDir \"lib\\net45\" -Removal",
        "}",
        "Remove-Item \"$dir\\`$1\", \"$dir\\`$PLUGINSDIR\" -Force -Recurse -ErrorAction SilentlyContinue"
    ],
    "shortcuts": [
        [
            "KOOK.exe",
            "KOOK"
        ]
    ],
    "post_install": [
        "$appdata = \"$env:APPDATA\\KOOK\"",
        "if (!(Test-Path $persist_dir)) { New-Item $persist_dir -ItemType Directory -Force | Out-Null }",
        "if (Test-Path $appdata) {",
        "    if (-not (Get-Item $appdata).Attributes.HasFlag([System.IO.FileAttributes]::ReparsePoint)) {",
        "        Move-Item \"$appdata\\*\" $persist_dir -Force -ErrorAction SilentlyContinue",
        "        Remove-Item $appdata -Force -Recurse",
        "    } else { Remove-Item $appdata -Force }",
        "}",
        "New-Item -ItemType Junction -Path $appdata -Target $persist_dir | Out-Null"
    ],
    "uninstaller": {
        "script": [
            "$appdata = \"$env:APPDATA\\KOOK\"",
            "if (Test-Path $appdata) {",
            "    $item = Get-Item $appdata",
            "    if ($item.Attributes.HasFlag([System.IO.FileAttributes]::ReparsePoint)) { Remove-Item $appdata -Force }",
            "}"
        ]
    },
    "checkver": {
        "url": "https://www.kookapp.cn/api/v2/updates/latest-version?platform=windows",
        "regex": "\"url\":\"(?<url>https://dl\\.kookapp\\.cn/assets/release/html_pc/kook_\\d+/Kook_PC_Setup_v([\\d.]+)_.+?)\""
    },
    "autoupdate": {
        "url": "$matchUrl#/dl.7z"
    }
}
