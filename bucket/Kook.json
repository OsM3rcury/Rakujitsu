{
    "version": "0.109.0.0",
    "description": "KOOK, formerly KaiHeiLa, is a voice communication tool that is known as the Chinese Discord",
    "homepage": "https://www.kookapp.cn/",
    "license": "Proprietary",
    "url": "https://dl.kookapp.cn/assets/release/html_pc/kook_3037/Kook_PC_Setup_v0.109.0.0_b2ZmaWNpYWwuc2l0ZS4uLi5wYw==.exe#/dl.7z",
    "hash": "1cc9d34efb23327752f7b55c3b47c89473ff80bfcaba265661dfa841517e0ebb",
    "installer": {
        "script": [
            "Expand-7zipArchive -Path \"$dir\\`$1\\SquirrelTemp\\app.7z\" -Destination \"$dir\" -Removal",
            "Expand-7zipArchive -Path \"$dir\\KOOK-*-full.nupkg\" -ExtractDir \"lib\\net45\" -Removal",
            "@('$PLUGINSDIR', '$1') | ForEach-Object {",
            "    Remove-Item \"$dir\\$_\" -Recurse -Force",
            "}",
            "# persist AppData",
            "$runtimeData = \"$env:APPDATA\\KOOK\"",
            "$persistData = \"$persist_dir\\appdata\"",
            "if (Test-Path $persistData) {",
            "    Remove-Item $runtimeData -Force -Recurse -ErrorAction SilentlyContinue",
            "    New-Item -Type Junction -Path $runtimeData -Target $persistData | Out-Null",
            "} else {",
            "    # AppData is created by the app on first run",
            "}"
        ]
    },
    "uninstaller": {
        "script": [
            "$runtimeData = \"$env:APPDATA\\KOOK\"",
            "$persistData = \"$persist_dir\\appdata\"",
            "if (!(Test-Path $persistData)) {",
            "    if (Test-Path $runtimeData) {",
            "        Move-Item $runtimeData $persistData -Force -ErrorAction SilentlyContinue",
            "    }",
            "} else {",
            "    Remove-Item $runtimeData -Force -Recurse -ErrorAction SilentlyContinue",
            "}"
        ]
    },
    "shortcuts": [
        [
            "KOOK.exe",
            "KOOK"
        ]
    ],
    "checkver": {
        "url": "https://www.kookapp.cn/api/v2/updates/latest-version?platform=windows",
        "regex": "https://(?<path>.*?)/Kook_PC_Setup_v([\\d.]+)_(?<base64>.*?).exe"
    },
    "autoupdate": {
        "url": "https://$matchPath/Kook_PC_Setup_v$version_$matchBase64.exe#/dl.7z"
    }
}
