{
    "version": "1.0.0.44",
    "description": "马维斯 - 腾讯出品的桌面智能助手",
    "homepage": "https://marvis.qq.com/",
    "license": "Proprietary",
    "url": "https://marvis.qq.com/download/exe#/dl.7z",
    "hash": "e57694ca6eb2df00506337f3db6c73817544e6e3adeb8184fbb4c62a5b6b1080",
    "pre_install": [
        "if (Test-Path \"$dir\\`$PLUGINSDIR\\app-64.7z\") {",
        "    Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
        "}",
        "Remove-Item \"$dir\\`$*\", \"$dir\\Uninst*\", \"$dir\\*.exe\" -Force -Recurse -ErrorAction SilentlyContinue"
    ],
    "bin": "Marvis.exe",
    "shortcuts": [
        [
            "Marvis.exe",
            "Marvis"
        ]
    ],
    "post_install": [
        "$appdata = \"$env:LOCALAPPDATA\\Marvis\"",
        "if (!(Test-Path $persist_dir)) { New-Item $persist_dir -ItemType Directory -Force | Out-Null }",
        "if (Test-Path $appdata) {",
        "    if (-not (Get-Item $appdata).Attributes.HasFlag([System.IO.FileAttributes]::ReparsePoint)) {",
        "        Move-Item \"$appdata\\*\" $persist_dir -Force -ErrorAction SilentlyContinue",
        "        Remove-Item $appdata -Force -Recurse",
        "    } else { Remove-Item $appdata -Force }",
        "}",
        "New-Item -ItemType Junction -Path $appdata -Target $persist_dir | Out-Null"
    ],
    "uninstaller": {
        "script": [
            "$appdata = \"$env:LOCALAPPDATA\\Marvis\"",
            "if (Test-Path $appdata) {",
            "    $item = Get-Item $appdata",
            "    if ($item.Attributes.HasFlag([System.IO.FileAttributes]::ReparsePoint)) { Remove-Item $appdata -Force }",
            "}"
        ]
    },
    "checkver": {
        "script": [
            "$req = [System.Net.WebRequest]::Create('https://marvis.qq.com/download/exe')",
            "$req.AllowAutoRedirect = $false",
            "$resp = $req.GetResponse()",
            "$resolved = $resp.Headers['Location']",
            "$resp.Close()",
            "return $resolved"
        ],
        "regex": "marvis_\\d+_([\\d.]+)_"
    },
    "autoupdate": {
        "url": "https://marvis.qq.com/download/exe#/dl.7z"
    }
}
