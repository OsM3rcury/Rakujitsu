{
    "version": "1.0.0.44",
    "description": "马维斯 - 腾讯出品的桌面智能助手",
    "homepage": "https://marvis.qq.com/",
    "license": "Proprietary",
    "architecture": {
        "64bit": {
            "url": "https://marvis.qq.com/download/exe",
            "hash": "E57694CA6EB2DF00506337F3DB6C73817544E6E3ADEB8184FBB4C62A5B6B1080"
        }
    },
    "installer": {
        "script": [
            "$installer = Get-ChildItem \"$dir\\*.exe\" | Select-Object -First 1",
            "Start-Process -FilePath $installer.FullName -ArgumentList \"/S /D=$dir\" -Wait",
            "# persist AppData",
            "$runtimeData = \"$env:LOCALAPPDATA\\Marvis\"",
            "$persistData = \"$persist_dir\\appdata\"",
            "if (Test-Path $persistData) {",
            "    Remove-Item $runtimeData -Force -Recurse -ErrorAction SilentlyContinue",
            "    New-Item -Type Junction -Path $runtimeData -Target $persistData | Out-Null",
            "} else {",
            "    # AppData is created by the app on first run",
            "}"
        ]
    },
    "uninstaller": {
        "script": [
            "$runtimeData = \"$env:LOCALAPPDATA\\Marvis\"",
            "$persistData = \"$persist_dir\\appdata\"",
            "if (!(Test-Path $persistData)) {",
            "    if (Test-Path $runtimeData) {",
            "        Move-Item $runtimeData $persistData -Force -ErrorAction SilentlyContinue",
            "    }",
            "} else {",
            "    Remove-Item $runtimeData -Force -Recurse -ErrorAction SilentlyContinue",
            "}"
        ]
    },
    "shortcuts": [
        [
            "Marvis.exe",
            "Marvis"
        ]
    ],
    "checkver": {
        "script": [
            "$req = [System.Net.WebRequest]::Create('https://marvis.qq.com/download/exe')",
            "$req.AllowAutoRedirect = $false",
            "$resp = $req.GetResponse()",
            "$resp.Headers['Location']",
            "$resp.Close()"
        ],
        "regex": "marvis_\\d+_([\\d.]+)_"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://marvis.qq.com/download/exe"
            }
        }
    }
}
